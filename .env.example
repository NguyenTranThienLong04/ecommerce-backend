# Local example. Copy via npm run setup:local; .env.local is ignored.
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27018/clothing_demo?replicaSet=rs0&directConnection=true
# Required, minimum 32 characters. setup:local generates a fresh random value.
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated IP/CIDR allowlist for your actual reverse proxies.
# Empty means direct connections; never set true or a hop count.
TRUST_PROXY=
# Local/demo only. Seed refuses production and non-local databases.
DEMO_PASSWORD=LocalDemo123!
# Optional integrations: enabling either requires all its fields below.
CLOUDINARY_ENABLED=false
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
VNPAY_ENABLED=false
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5000/api/vnpay/return
VNP_RESULT_URL=http://localhost:3000/payment-result
# Register /api/vnpay/ipn on the PUBLIC backend with the provider, separately.
